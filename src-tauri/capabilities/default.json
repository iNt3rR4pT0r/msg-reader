{
  "$schema": "https://schemas.tauri.app/capabilities/1.0.0",
  "identifier": "default",
  "description": "Default permissions for msgReader",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-webview-position",
    "core:webview:allow-set-webview-focus",
    "core:webview:allow-print",
    "core:window:default",
    "updater:default",
    "dialog:default",
    "process:default"
  ]
}
